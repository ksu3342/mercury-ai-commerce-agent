{"rule_id":"EU_GPSR_RESPONSIBLE_PERSON_REQUIRED","version":"demo-policy-2026-05","market_ids":["DE"],"category_scope":["kitchen_appliance","consumer_electronics","home_lighting"],"rule_type":"required_field","severity":"blocker","source":{"name":"EU GPSR demo rule pack","url":"mock://policy/eu-gpsr/responsible-person"},"condition":{"all":[{"field":"market.region","operator":"equals","value":"EU"}]},"check":{"field":"listing.attributes.responsible_person","operator":"exists"},"message":"EU market requires responsible_person before mock export approval.","remediation":"Add responsible_person name, address, and contact field."}
{"rule_id":"US_UNSUPPORTED_HEALTH_CLAIM","version":"demo-policy-2026-05","market_ids":["US"],"category_scope":["kitchen_appliance","beauty_personal_care"],"rule_type":"forbidden_claim","severity":"blocker","source":{"name":"US claims demo rule pack","url":"mock://policy/us/unsupported-health-claims"},"condition":{"any":[{"field":"listing.claims.claim_type","operator":"equals","value":"medical"},{"field":"listing.text","operator":"contains_any","value":["cure","treat","guaranteed healthy","100% safe"]}]},"check":{"field":"listing.claims","operator":"no_unsupported_health_claim"},"message":"Unsupported health or medical claims are not allowed in the demo policy.","remediation":"Remove medical, cure, treatment, or guaranteed outcome language."}
{"rule_id":"MARKET_FORBIDDEN_CLAIM","version":"demo-policy-2026-05","market_ids":["US","DE"],"category_scope":["all"],"rule_type":"forbidden_claim","severity":"blocker","source":{"name":"Market forbidden claim demo rule pack","url":"mock://policy/market/forbidden-claims"},"condition":{"field":"listing.text","operator":"contains_any_market_forbidden_claim"},"check":{"field":"listing.text","operator":"does_not_contain_forbidden_claim"},"message":"Forbidden market claim was found in listing text.","remediation":"Remove forbidden market claim language before review."}
{"rule_id":"FOOD_CONTACT_MATERIAL_DISCLOSURE","version":"demo-policy-2026-05","market_ids":["US","DE"],"category_scope":["kitchen_appliance"],"rule_type":"claim_tone","severity":"warning","source":{"name":"Food contact demo rule pack","url":"mock://policy/food-contact/material-disclosure"},"condition":{"field":"product.regulatory_tags","operator":"contains","value":"food_contact"},"check":{"field":"listing.claims","operator":"avoid_absolute_safety_claims"},"message":"Food contact material language should stay factual and avoid absolute safety guarantees.","remediation":"Keep material facts, avoid broad safety or medical claims."}
{"rule_id":"BATTERY_CAPACITY_FIELD_REQUIRED","version":"demo-policy-2026-05","market_ids":["US","DE"],"category_scope":["kitchen_appliance","consumer_electronics"],"rule_type":"required_field","severity":"warning","source":{"name":"Battery fields demo rule pack","url":"mock://policy/battery/capacity-field"},"condition":{"field":"product.regulatory_tags","operator":"contains","value":"battery"},"check":{"field":"listing.attributes.battery_capacity_mah","operator":"exists"},"message":"Rechargeable battery products should preserve battery capacity and charger type fields.","remediation":"Keep battery_capacity_mah and charger_type in structured attributes."}
{"rule_id":"ELECTRICAL_POWER_FIELD_REQUIRED","version":"demo-policy-2026-05","market_ids":["US","DE"],"category_scope":["home_lighting","consumer_electronics"],"rule_type":"required_field","severity":"blocker","source":{"name":"Electrical product demo rule pack","url":"mock://policy/electrical/power-fields"},"condition":{"field":"product.regulatory_tags","operator":"contains_any","value":["electrical_safety","power_rating"]},"check":{"field":"listing.attributes.power_watt","operator":"exists"},"message":"Electrical products must preserve power rating fields before mock export approval.","remediation":"Add power_watt and, where applicable, input_voltage and output_voltage from source product data."}
{"rule_id":"COMPATIBILITY_CLAIM_NEEDS_SCOPE","version":"demo-policy-2026-05","market_ids":["US","DE"],"category_scope":["consumer_electronics"],"rule_type":"claim_scope","severity":"warning","source":{"name":"Compatibility claim demo rule pack","url":"mock://policy/claims/compatibility-scope"},"condition":{"field":"listing.text","operator":"contains_any","value":["works with all devices","compatible with every device","universal for all"]},"check":{"field":"listing.claims","operator":"requires_supported_scope"},"message":"Broad compatibility claims need a supported scope.","remediation":"Replace all-device claims with scoped compatibility based on provided product data."}
{"rule_id":"SAFETY_CLAIM_NEEDS_EVIDENCE","version":"demo-policy-2026-05","market_ids":["US","DE"],"category_scope":["home_lighting","consumer_electronics"],"rule_type":"unsupported_claim","severity":"blocker","source":{"name":"Safety claim demo rule pack","url":"mock://policy/claims/safety-evidence"},"condition":{"field":"listing.text","operator":"contains_any","value":["100% safe","guaranteed safe","risk-free"]},"check":{"field":"listing.claims","operator":"must_have_evidence_or_remove"},"message":"Absolute safety claims need evidence and should not be generated from missing proof.","remediation":"Remove absolute safety language or attach approved evidence before review."}
{"rule_id":"BRAND_TERM_DO_NOT_TRANSLATE","version":"brand-terms-2026-05","market_ids":["US","DE"],"category_scope":["all"],"rule_type":"terminology","severity":"warning","source":{"name":"Brand terms demo pack","url":"mock://terms/mori"},"condition":{"field":"product.brand","operator":"equals","value":"Mori"},"check":{"field":"listing.title","operator":"contains","value":"Mori"},"message":"Brand term Mori must not be translated or localized.","remediation":"Keep Mori exactly as provided."}
{"rule_id":"TITLE_LENGTH_BY_MARKET","version":"demo-policy-2026-05","market_ids":["US","DE"],"category_scope":["all"],"rule_type":"length","severity":"warning","source":{"name":"Title length demo rule pack","url":"mock://policy/title-length"},"condition":{"field":"listing.title","operator":"exists"},"check":{"field":"listing.title.length","operator":"less_than_or_equal_market_max"},"message":"Title length should respect MarketConfig.locale_rules.max_title_length.","remediation":"Shorten the title if it exceeds the configured market limit."}
